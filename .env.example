# ========================================================
# MikroTik Log Stack Environment Configuration
# คัดลอกไฟล์นี้เป็น .env แล้วกำหนดค่ารหัสผ่านจริง
# ห้าม commit ไฟล์ .env ขึ้น Git เด็ดขาด
# ========================================================

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_password_here

# PostgreSQL Database Credentials
POSTGRES_DB=grafana
POSTGRES_USER=grafana
POSTGRES_PASSWORD=your_secure_password_here

# Ports Configuration
GRAFANA_PORT=3301
SYSLOG_UDP_PORT=514
ALLOY_HTTP_PORT=12345
